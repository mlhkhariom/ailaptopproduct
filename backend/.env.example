# ═══════════════════════════════════════════════════════════
# AI Laptop Wala — Backend Environment Variables
# ═══════════════════════════════════════════════════════════
#
# ⚠️ IMPORTANT: Most config moved to Admin → Settings (DB)
# .env is only for INFRASTRUCTURE values that cannot be in DB
# (because code needs them BEFORE DB connection works)
#
# DB-first pattern: All admin-configurable settings live in
# app_settings/site_settings tables. Admin can change them
# without restarting the server. .env values are fallbacks only.
# ═══════════════════════════════════════════════════════════

# ── INFRASTRUCTURE (required — cannot move to DB) ──────────
PORT=5000
DB_PATH=./data/ailaptopwala.db
DATABASE_URL=postgresql://ailaptop:ailaptop2026@localhost:5432/ailaptopwala
# DATABASE_SSL=true  # uncomment for managed PG (Supabase/Neon/RDS)
JWT_SECRET=ailaptopwala_jwt_secret_2026_asati_infotech_indore
NODE_ENV=development

# ── FALLBACK VALUES (preferred location: Admin Settings) ───
# These act as fallback ONLY if DB is empty.
# Admin Settings values take priority.

# URLs (Admin → Settings → General → System URLs)
FRONTEND_URL=http://localhost:8080
# BACKEND_URL=https://api.ailaptopwala.com  # for webhooks

# Owner (Admin → Settings → General → System URLs)
OWNER_PHONE=9893496163

# SMTP (Admin → Settings → API Keys → SMTP Email Server)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=info@ailaptopwala.com
# SMTP_PASS=your_app_password
# SMTP_FROM=AI Laptop Wala <info@ailaptopwala.com>

# Razorpay (Admin → Settings → API Keys → Razorpay)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxx

# E-Invoice / GST IRP (Admin → Settings → General → E-Invoice)
# EINVOICE_BASE=https://einv-apisandbox.nic.in
# EINVOICE_GSTIN=23AABCU9603R1ZX
# EINVOICE_USERNAME=your_gsp_user
# EINVOICE_PASSWORD=your_gsp_pass
# EINVOICE_APPKEY=your_32char_appkey

# Supabase — optional file storage (Admin → Settings → General → Supabase)
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGc...
